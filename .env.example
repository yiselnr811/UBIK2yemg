# ============================================
# UBIK2 YEMG — Variables de entorno
# ============================================
# Copia este archivo a .env y rellena los valores.
# NUNCA subas .env real a git (está en .gitignore).
# Variables marcadas con [PÚBLICA] se exponen al navegador via NEXT_PUBLIC_*.

# --- Base de Datos (MongoDB Atlas) ---
MONGO_URL=mongodb+srv://[redacted]@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=ubik2_yemg

# --- Autenticación (JWT) ---
# IMPORTANTE: Usa un secreto fuerte (32+ chars aleatorios). En producción NO uses el fallback.
JWT_SECRET=[redacted]

# --- Email (Resend) ---
# Obtén tu API key en https://resend.com/api-keys
# En sandbox solo puedes enviar a tu propio email verificado.
RESEND_API_KEY=[redacted]
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=UBIK2 YEMG

# --- URLs públicas [PÚBLICA] ---
# URL base de tu despliegue (Render, dominio propio, etc.). SIN barra final.
NEXT_PUBLIC_BASE_URL=https://tudominio.com

# --- Imágenes (Cloudinary) ---
# Config en https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# --- CORS (opcional) [PÚBLICA] ---
# Orígenes permitidos para la API. Por defecto '*'.
# Ejemplo: CORS_ORIGINS=https://tudominio.com,https://www.tudominio.com
CORS_ORIGINS=*

# --- Pagos Crypto PROPIOS (Self-Custody) ---
# SOLO direcciones PÚBLICAS (receive-only). NUNCA private keys, mnemonics, seeds.
# Formato: CRYPTO_WALLET_<RED>_<TOKEN>=ADDRESS
# Ejemplos (reemplazar con tus direcciones reales):
CRYPTO_WALLET_TRC20_USDT=TXyZ123ExampleUSDTTRC20WalletAddressChangeMe
CRYPTO_WALLET_ERC20_USDT=0x1234567890123456789012345678901234567890
CRYPTO_WALLET_ERC20_USDC=0x1234567890123456789012345678901234567890
CRYPTO_WALLET_POLYGON_USDT=0x1234567890123456789012345678901234567890
CRYPTO_WALLET_POLYGON_USDC=0x1234567890123456789012345678901234567890
CRYPTO_WALLET_BASE_USDT=0x1234567890123456789012345678901234567890
CRYPTO_WALLET_BASE_USDC=0x1234567890123456789012345678901234567890
CRYPTO_WALLET_ARBITRUM_USDT=0x1234567890123456789012345678901234567890
CRYPTO_WALLET_ARBITRUM_USDC=0x1234567890123456789012345678901234567890
CRYPTO_WALLET_BEP20_USDT=0x1234567890123456789012345678901234567890
CRYPTO_WALLET_BEP20_USDC=0x1234567890123456789012345678901234567890

# RPC URLs (públicos gratuitos, sin API key) — para verificación automática ETAPA 4
CRYPTO_RPC_TRON=https://api.trongrid.io
CRYPTO_RPC_ETHEREUM=https://eth.llamarpc.com
CRYPTO_RPC_POLYGON=https://polygon-rpc.com
CRYPTO_RPC_BASE=https://mainnet.base.org
CRYPTO_RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
CRYPTO_RPC_BEP20=https://bsc-rpc.publicnode.com

# Configuración de facturas
CRYPTO_INVOICE_EXPIRY_MINUTES=30           # Vencimiento factura
CRYPTO_MIN_CONFIRMATIONS_TRC20=1           # Confirmaciones requeridas por red
CRYPTO_MIN_CONFIRMATIONS_ERC20=12
CRYPTO_MIN_CONFIRMATIONS_POLYGON=20
CRYPTO_MIN_CONFIRMATIONS_BASE=2
CRYPTO_MIN_CONFIRMATIONS_ARBITRUM=20
CRYPTO_MIN_CONFIRMATIONS_BEP20=15

# Tolerancias (porcentaje sobre expectedAmount)
CRYPTO_UNDERPAY_TOLERANCE_PCT=0.5          # 0.5% bajo = underpaid
CRYPTO_OVERPAY_TOLERANCE_PCT=5             # 5% sobre = overpaid (requiere revisión manual)

# Monedas/redes habilitadas (CSV) — solo las que tengas wallet configurada
CRYPTO_ENABLED_NETWORKS=BASE_USDT,BASE_USDC,ARBITRUM_USDT,ARBITRUM_USDC,BEP20_USDT,BEP20_USDC

# Tipo de cambio CUP -> USD (para convertir totales a USD en pagos crypto)
USD_RATE=120

# --- Pasarela Crypto EXTERNA (NOWPayments) - DEPRECATED ---
# El sistema ahora usa billeteras propias. Estas variables ya no se usan.
# NOWPAYMENTS_API_KEY=tu_api_key_aqui
# NOWPAYMENTS_IPN_SECRET=[redacted]  # Genera en Dashboard > Settings > IPN
# NOWPAYMENTS_ENV=sandbox  # o 'production'

# --- Administrador (SOLO servidor; nunca NEXT_PUBLIC_) ---
# Usadas por POST /api/seed para crear/reconciliar el admin. Si faltan, se omite.
# Contraseña de mínimo 12 caracteres. No las escribas en el código ni en el repo.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_LEGACY_EMAILS=correo1@ejemplo.com,correo2@ejemplo.com

# --- Verificación de identidad de vendedores (Didit) ---
# Configurar los valores reales como variables privadas en Render.
# Nunca guardar claves reales en este archivo.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
